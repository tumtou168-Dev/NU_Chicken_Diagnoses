# Copy to .env and fill in real values:  cp .env.example .env
# Generate a secret key with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Use letters and digits only for the password (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=change-me

# Google OAuth 2.0 (Optional - required for Continue with Google)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP Email Configuration (Optional - for Password Reset)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-gmail-16-char-app-password
# MAIL_DEFAULT_SENDER=IDNS Support <your-email@gmail.com>

# Optional overrides
# POSTGRES_DB=chicken_diagnoses
# POSTGRES_USER=chicken
# APP_PORT=8000
# WEB_CONCURRENCY=2
